   "url": "https://www.planbmalmo.com/_next/data/BGXMcDq1ubcDHY6E2d3H5/en/events/the-temperance-movement-uk/cZHOqrPaQO.json?name=the-temperance-movement-uk&id=cZHOqrPaQO",
   "method": "GET",
