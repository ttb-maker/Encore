   "url": "https://www.planbmalmo.com/_next/data/BGXMcDq1ubcDHY6E2d3H5/en/events/nationalteaterns-rockorkester/G5wUxdunpo.json?name=nationalteaterns-rockorkester&id=G5wUxdunpo",
   "method": "GET",
