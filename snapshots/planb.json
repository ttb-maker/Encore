   "ct": "application/json",
   "body": "{\"pageProps\":{\"postData\":{\"id\":\"RHAxg3ac4K\",\"name\":\"Super Jet Kinoko (JP)\",\"start_time\":\"2026-10-30T22:00:00.000Z\",\"tags\":[\"psych\",\"club\",\"rock\"],\"tagsFlattened\":\"#psych #club #rock \",\"details\":\"CONCERT: Super Jet Kinoko (JP)\\n\\nWe're bringing the mind-melting energy of Osaka, Japan, back to Plan B on October 30!\\n\\n\\n\\nSUPER JET KINOKO is a rare, innovative band that's hit the party circuit like a meteor. This is not your average concert; it's a breathtaking live performance that engulfs and twists the space around them.\\n\\n\\n\\nExpect a fusion of rock, trance, and psychedelic influences, led by the guitar wizardry of Daoud (from the legendary band Kikagaku Moyo). Think outlandish, wild, and utterly explosive energy.\\n\\n\\n\\nMusic should be felt, not described. Don't miss this singular chance to experience one of Japan's most vital psych acts.\",\"custom_fields\":{\"end_time\":\"2026-10-31T02:00:00.000Z\",\"published\":true,\"age\":\"18\",\"cover\":\"150 SEK\",\"coverCharge\":\"150 SEK\",\"type\":\"Concert\",\"facebookEvent\":\"\",\"ticketUrl\":\"https://nortic.se/ticket/event/85289\",\"freeEntry\":false,\"soldOut\":false,\"moreInfo\":\"\",\"eventStatus\":\"ONSALE\",\"onlineOnly\":false,\"ticketmasterId\":\"\",\"streamingLink\":\"\",\"youtube\":\"itgipHxdDUw\",\"blurb\":\"\",\"secondaryTitle\":\"Nightclub show!\",\"embeds\":[{\"type\":\"spotify\",\"name\":\"Super Jet Kinoko\",\"id\":\"https://open.spotify.com/artist/1VpmNLzbYNlRE1gv8kRIlz?si=smbsd8AfSqWe-O323xuVhw\"}],\"relatedEvents\":[],\"hideTimesOnSchedule\":false,\"zone\":\"\",\"show_start_time\":\"2026-10-30T23:00:00.000Z\"},\"place\":{\"id\":\"MqFen6RaHG\",\"name\":\"Plan B - Malmö \",\"address\":\"Norra Grängesbergsgatan 26B\",\"city\":\"Malmö\",\"state\":\"Malmö\",\"country\":\"Sweden\",\"website\":\"https://www.planbmalmo.com/\",\"postal_code\":\"214 50\",\"latitude\":55.584110734703266,\"longitude\":13.027543481614178,\"custom_fields\":{\"ticketProvi