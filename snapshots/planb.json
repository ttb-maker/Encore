   "url": "https://www.planbmalmo.com/_next/data/BGXMcDq1ubcDHY6E2d3H5/en/events/dnbk-pres-kallsup/wYRi05Ayzo.json?name=dnbk-pres-kallsup&id=wYRi05Ayzo",
   "method": "GET",
