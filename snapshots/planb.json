0qK\",\"link\":\"terra/sVB45xqy3e\",\"ticketLink\":\"https://nortic.se/ticket/event/85966\"},{\"objectId\":\"Kb6MdlCqKx\",\"type\":\"event\",\"title\":\"Jonas Lundqvist \",\"info\":\"28/11/26 \",\"image\":\"https://ik.imagekit.io/mfgbmrqfuvo/venues/event_qSt08Gb3W\",\"link\":\"jonas-lundqvist/Kb6MdlCqKx\",\"ticketLink\":\"https://www.nortic.se/ticket/show/349529\"},{\"objectId\":\"mXowEmMFc8\",\"type\":\"event\",\"title\":\"LKN\",\"info\":\"28/11/26 \",\"image\":\"\n…[afkortet]"
