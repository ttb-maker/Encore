   "url": "https://www.planbmalmo.com/_next/data/BGXMcDq1ubcDHY6E2d3H5/en/events/jonas-lundqvist/Kb6MdlCqKx.json?name=jonas-lundqvist&id=Kb6MdlCqKx",
   "method": "GET",
