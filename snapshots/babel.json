   "body": "{\"formConfig\":{\"actions\":{},\"translations\":{\"contact:firstName\":\"Förnamn\",\"contact:lastName\":\"Efternamn\",\"contact:gender\":\"Kön\",\"contact:email\":\"E-post\",\"contact:address:city\":\"Stad\",\"contact:address:line1\":\"Adress\",\"contact:address:line2\":\"Adressrad 2\",\"contact:address:zipCode\":\"Postnummer\",\"internal:submit\":\"Skicka\",\"internal:privacyPolicy\":\"Jag vill få e-postutskick med nyheter och erbjudanden, och accepterar att mina personuppgifter behandlas i enlighet med Privacy Policyn\",\"state:onSuccess\":\"<span>Nästan klart! Klicka bara på bekräftelselänken i mailet som kommer strax. Tack för att du vill prenumerera på våra utskick.</span>\",\"state:onError\":\"Hoppsan, något gick fel. Vänligen försök igen\",\"gender:male\":\"Man\",\"gender:female\":\"Kvinna\",\"gender:other\":\"Annat\",\"gender:no-answer\":\"Jag föredrar att inte svara\",\"validation:isRequired\":\"Fältet {label} är obligatoriskt\",\"validation:isEmail\":\"Fältet {label} måste vara en giltig e-postadress\",\"validation:minLength\":\"Fältet {label} måste minst vara {minLength} tecken\",\"validation:maxLength\":\"Fältet {label} får inte vara längre än {maxLength} tecken\",\"validation:minValue\":\"Fältet {label} måste minst vara {minValue}\",\"validation:maxValue\":\"Fältet {label} får inte vara högre än {maxValue}\"},\"items\":[{\"type\":\"string\",\"component\":\"Text\",\"label\":\"\",\"placeholder\":\"Förnamn\",\"field\":\"contact:firstName\",\"validations\":[],\"options\":[],\"hidden\":false},{\"type\":\"string\",\"component\":\"Text\",\"label\":\"\",\"placeholder\":\"Efternamn\",\"field\":\"contact:lastName\",\"validations\":[],\"options\":[],\"hidden\":false},{\"type\":\"string\",\"component\":\"Text\",\"label\":\"\",\"placeholder\":\"E-postadress\",\"field\":\"contact:email\",\"validations\":[{\"name\":\"isRequired\",\"value\":true},{\"name\":\"isEmail\",\"value\":true}],\"options\":[],\"hidden\":false},{\"type\":\"stringList\",\"component\":